{
  "name": "@squadflow/desktop",
  "productName": "SquadFlow",
  "version": "0.1.0",
  "private": true,
  "description": "SquadFlow desktop application.",
  "license": "Apache-2.0",
  "author": "SquadFlow",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "test:scripts": "node --test scripts/app-updater.test.cjs scripts/desktop-paths.test.cjs scripts/packaged-services.test.cjs scripts/service-ports.test.cjs",
    "pack:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:mac:release": "bash scripts/desktop-macos.sh release",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.squadflow.desktop",
    "productName": "SquadFlow",
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "app-updater.js",
      "desktop-paths.js",
      "main.js",
      "navigation-url.js",
      "packaged-services.js",
      "service-ports.js",
      "preload.js",
      "browser-preload.js",
      "assets/**/*",
      "package.json",
      {
        "from": "../local-service/dist",
        "to": "local-service"
      },
      {
        "from": "../local-service/package.json",
        "to": "local-service/package.json"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "legal/NOTICE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../legal",
        "to": "legal/third-party"
      },
      {
        "from": ".staging/runtime/legal",
        "to": "legal/runtime"
      },
      {
        "from": ".staging/runtime/renderer",
        "to": "renderer"
      },
      {
        "from": "resources/codex-runtime",
        "to": "codex-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "identity": null,
      "notarize": false
    }
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.167",
    "@fastify/websocket": "11.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.10.1",
    "drizzle-orm": "0.45.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fastify": "5.8.5",
    "zod": "4.4.3"
  }
}
