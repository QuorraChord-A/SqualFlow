{
  "name": "Case 1: 正常路径 - clarify → develop → verify pass → review pass → idle",
  "description": "验证完整正常流程：创建 Flow → 连接 WS → 发送消息 → clarify → develop → verify pass → review pass → Run done / Flow idle，并验证数据库记录正确",
  "category": "e2e",
  "steps": [
    "open-homepage",
    {
      "atom": "create-project",
      "params": {
        "name": "Case1 Normal Path",
        "path": "/tmp/case1-normal"
      }
    },
    {
      "atom": "create-flow",
      "params": {
        "name": "Case1 Normal Path Test",
        "description": "Case1 Normal Path Test"
      }
    },
    {
      "atom": "select-flow",
      "params": {
        "flowName": "Case1 Normal Path Test"
      }
    },
    {
      "atom": "select-flow-project",
      "params": {
        "projectName": "Case1 Normal Path"
      }
    },
    "verify-realtime-ready",
    {
      "atom": "send-message",
      "params": {
        "message": "Python实现根据表达式来支持加减乘除计算结果"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 10
      }
    },
    {
      "atom": "verify-event-type",
      "params": {
        "eventType": "flow:phase_started"
      }
    },
    {
      "verify": [
        "聊天区或右侧右侧数据面板中出现 clarify"
      ]
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 20
      }
    },
    {
      "atom": "respond-to-decision-card",
      "params": {
        "question": "需求理解是否正确",
        "answer": "通过"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 30
      }
    },
    {
      "verify": [
        "聊天区或右侧右侧数据面板中出现 develop",
        "聊天区或右侧右侧数据面板中出现 verify",
        "聊天区或右侧右侧数据面板中出现 review"
      ]
    },
    {
      "atom": "verify-database-flow-status",
      "params": {
        "flowId": "$context.flowId",
        "expectedStatus": "idle"
      }
    },
    {
      "atom": "verify-database-flow-phases",
      "params": {
        "flowId": "$context.flowId",
        "runId": "$context.runId",
        "expectedPhases": [
          "clarify",
          "develop",
          "verify",
          "review"
        ]
      }
    },
    {
      "atom": "verify-database-flow-tasks",
      "params": {
        "flowId": "$context.flowId",
        "expectedStatus": "done",
        "minCount": 4
      }
    },
    {
      "atom": "verify-phase-graph-edges",
      "params": {
        "flowId": "$context.flowId",
        "expectedEdges": [
          [
            "clarify",
            "develop"
          ],
          [
            "develop",
            "verify"
          ],
          [
            "verify",
            "review"
          ]
        ]
      }
    }
  ]
}
