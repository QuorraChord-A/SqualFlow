{
  "name": "Case 2: Fix 回环 - verify fail → develop fix → verify pass",
  "description": "验证 fix 回环流程：verify 失败后回到 develop 修复，再次 verify 通过，验证数据库 fix_count 和 phase 记录",
  "category": "e2e",
  "steps": [
    "open-homepage",
    {
      "atom": "create-project",
      "params": {
        "name": "Case2 Fix Loop",
        "path": "/tmp/case2-fixloop"
      }
    },
    {
      "atom": "create-flow",
      "params": {
        "name": "Case2 Fix Loop Test",
        "description": "Case2 Fix Loop Test"
      }
    },
    {
      "atom": "select-flow",
      "params": {
        "flowName": "Case2 Fix Loop Test"
      }
    },
    {
      "atom": "select-flow-project",
      "params": {
        "projectName": "Case2 Fix Loop"
      }
    },
    "verify-realtime-ready",
    {
      "atom": "send-message",
      "params": {
        "message": "Python实现一个有bug的计算器"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 40
      }
    },
    {
      "verify": [
        "聊天区或右侧右侧数据面板中出现 clarify",
        "聊天区或右侧右侧数据面板中出现 develop",
        "聊天区或右侧右侧数据面板中出现 verify"
      ]
    },
    {
      "verify": [
        "聊天区或右侧右侧数据面板中出现 fail",
        "聊天区或右侧右侧数据面板中出现 fix_count"
      ]
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 30
      }
    },
    {
      "verify": [
        "聊天区或右侧右侧数据面板中出现 develop",
        "聊天区或右侧右侧数据面板中出现 verify",
        "聊天区或右侧右侧数据面板中出现 pass"
      ]
    },
    {
      "atom": "verify-database-flow-phases",
      "params": {
        "flowId": "$context.flowId",
        "runId": "$context.runId",
        "expectedPhases": [
          "clarify",
          "develop",
          "verify",
          "develop",
          "verify"
        ]
      }
    },
    {
      "atom": "verify-database-flow-tasks",
      "params": {
        "flowId": "$context.flowId",
        "expectedStatus": "done",
        "minCount": 5
      }
    }
  ]
}
