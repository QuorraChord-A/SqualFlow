{
  "name": "Case 6: Diagnose DecisionCard - fix 超限 → diagnose → 用户选择回退",
  "description": "验证 diagnose 阶段的 DecisionCard：fix 超限进入 diagnose → Leader 分析根因 → 展示 DecisionCard → 用户选择回退目标 → 验证 diagnose phase 记录和 fix_count 重置",
  "category": "e2e",
  "steps": [
    "open-homepage",
    {
      "atom": "create-project",
      "params": {
        "name": "Case6 Diagnose",
        "path": "/tmp/case6-diagnose"
      }
    },
    {
      "atom": "create-flow",
      "params": {
        "name": "Case6 Diagnose Test",
        "description": "Case6 Diagnose Test"
      }
    },
    {
      "atom": "select-flow",
      "params": {
        "flowName": "Case6 Diagnose Test"
      }
    },
    {
      "atom": "select-flow-project",
      "params": {
        "projectName": "Case6 Diagnose"
      }
    },
    "verify-realtime-ready",
    {
      "atom": "send-message",
      "params": {
        "message": "实现一个需要多次修复的复杂功能"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 60
      }
    },
    {
      "verify": [
        "聊天区或右侧右侧数据面板中出现 diagnose",
        "聊天区或右侧右侧数据面板中出现 decision_card"
      ]
    },
    {
      "atom": "respond-to-decision-card",
      "params": {
        "question": "选择回退目标",
        "answer": "architecture"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 40
      }
    },
    {
      "verify": [
        "聊天区或右侧右侧数据面板中出现 architecture",
        "聊天区或右侧右侧数据面板中出现 develop"
      ]
    },
    {
      "atom": "verify-database-flow-phases",
      "params": {
        "flowId": "$context.flowId",
        "runId": "$context.runId",
        "expectedPhases": [
          "clarify",
          "develop",
          "verify",
          "verify",
          "verify",
          "diagnose",
          "architecture",
          "develop"
        ]
      }
    }
  ]
}
