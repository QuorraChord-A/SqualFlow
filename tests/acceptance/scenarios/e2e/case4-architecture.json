{
  "name": "Case 4: Architecture 阶段 - clarify → architecture → develop",
  "description": "验证包含 architecture 阶段的流程：clarify → architecture → develop → verify → review，验证 architecture phase 记录和 plan 审批",
  "category": "e2e",
  "steps": [
    "open-homepage",
    {
      "atom": "create-project",
      "params": {
        "name": "Case4 Architecture",
        "path": "/tmp/case4-architecture"
      }
    },
    {
      "atom": "create-flow",
      "params": {
        "name": "Case4 Architecture Test",
        "description": "Case4 Architecture Test"
      }
    },
    {
      "atom": "select-flow",
      "params": {
        "flowName": "Case4 Architecture Test"
      }
    },
    {
      "atom": "select-flow-project",
      "params": {
        "projectName": "Case4 Architecture"
      }
    },
    "verify-realtime-ready",
    {
      "atom": "send-message",
      "params": {
        "message": "设计一个复杂的微服务系统，需要详细的架构设计"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 15
      }
    },
    {
      "verify": [
        "聊天区或右侧右侧数据面板中出现 clarify"
      ]
    },
    {
      "atom": "respond-to-decision-card",
      "params": {
        "question": "是否需要架构设计",
        "answer": "需要"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 30
      }
    },
    {
      "verify": [
        "聊天区或右侧右侧数据面板中出现 architecture"
      ]
    },
    {
      "atom": "respond-to-decision-card",
      "params": {
        "question": "架构设计是否通过",
        "answer": "通过"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 50
      }
    },
    {
      "atom": "verify-database-flow-phases",
      "params": {
        "flowId": "$context.flowId",
        "runId": "$context.runId",
        "expectedPhases": [
          "clarify",
          "architecture",
          "develop",
          "verify",
          "review"
        ]
      }
    },
    {
      "atom": "verify-phase-graph-edges",
      "params": {
        "flowId": "$context.flowId",
        "expectedEdges": [
          [
            "clarify",
            "architecture"
          ],
          [
            "architecture",
            "develop"
          ]
        ]
      }
    }
  ]
}
