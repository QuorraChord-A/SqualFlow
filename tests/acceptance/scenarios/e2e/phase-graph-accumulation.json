{
  "name": "Phase Graph 累积验证",
  "description": "验证多次执行后 Phase Graph 是否正确累积节点和边",
  "category": "e2e",
  "steps": [
    "open-homepage",
    {
      "atom": "create-flow",
      "params": {
        "name": "Phase Graph Test",
        "description": "Phase Graph Test"
      }
    },
    {
      "atom": "select-flow",
      "params": {
        "flowName": "Phase Graph Test"
      }
    },
    "verify-realtime-ready",
    {
      "atom": "send-message",
      "params": {
        "message": "简单修改配置文件"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 30
      }
    },
    {
      "atom": "open-data-panel-tab",
      "params": {
        "tab": "Phases"
      }
    },
    {
      "atom": "verify-data-panel-section",
      "params": {
        "section": "Phases"
      }
    },
    {
      "verify": [
        "右侧数据面板中出现 clarify",
        "右侧数据面板中出现 develop"
      ]
    }
  ]
}
