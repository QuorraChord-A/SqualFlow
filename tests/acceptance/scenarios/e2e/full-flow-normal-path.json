{
  "name": "完整 Flow 执行流程 - 正常路径",
  "description": "验证完整流程：创建 Flow → 连接 WS → 发送消息 → 观察 flow:phase_started、session:chat_event → 响应 DecisionCard → 验证 flow:run_completed",
  "category": "e2e",
  "steps": [
    "open-homepage",
    {
      "atom": "create-project",
      "params": {
        "name": "E2E Calculator",
        "path": "/tmp/e2e-calculator"
      }
    },
    {
      "atom": "create-flow",
      "params": {
        "name": "Calculator E2E Test",
        "description": "Calculator E2E Test"
      }
    },
    {
      "atom": "select-flow",
      "params": {
        "flowName": "Calculator E2E Test"
      }
    },
    {
      "atom": "select-flow-project",
      "params": {
        "projectName": "E2E Calculator"
      }
    },
    "verify-realtime-ready",
    {
      "atom": "send-message",
      "params": {
        "message": "Python实现根据表达式来支持加减乘除计算结果"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 10
      }
    },
    {
      "atom": "verify-event-type",
      "params": {
        "eventType": "flow:phase_started"
      }
    },
    {
      "atom": "verify-event-type",
      "params": {
        "eventType": "session:chat_event"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 15
      }
    },
    {
      "atom": "respond-to-decision-card",
      "params": {
        "question": "需求理解是否正确",
        "answer": "通过"
      }
    },
    {
      "atom": "wait-for-events",
      "params": {
        "seconds": 20
      }
    },
    {
      "atom": "verify-flow-status",
      "params": {
        "status": "active"
      }
    }
  ]
}
