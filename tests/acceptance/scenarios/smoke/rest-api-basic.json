{
  "name": "REST API 基础功能验证",
  "description": "验证创建 Project、创建 Flow、选择 Flow 等 REST API 功能",
  "category": "smoke",
  "steps": [
    "open-homepage",
    {
      "atom": "create-project",
      "params": {
        "name": "Smoke Test Project",
        "path": "/tmp/smoke-test-project"
      }
    },
    {
      "atom": "create-flow",
      "params": {
        "name": "Smoke Test Flow",
        "description": "Smoke Test Flow"
      }
    },
    {
      "atom": "select-flow",
      "params": {
        "flowName": "Smoke Test Flow"
      }
    },
    {
      "atom": "verify-flow-status",
      "params": {
        "status": "ready"
      }
    }
  ]
}
