{
  "name": "真实产品页实时连接基础验证",
  "description": "验证真实产品页加载后实时连接可用，创建并选择 Flow 后能观察到流程状态",
  "category": "smoke",
  "steps": [
    "open-homepage",
    {
      "atom": "create-flow",
      "params": {
        "name": "WS Connection Test",
        "description": "WS Connection Test"
      }
    },
    {
      "atom": "select-flow",
      "params": {
        "flowName": "WS Connection Test"
      }
    },
    "verify-realtime-ready",
    {
      "atom": "verify-event-type",
      "params": {
        "eventType": "flow:status"
      }
    }
  ]
}
